#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$BIN_DIR:$PATH"

cmd="${1:-}"
shift || true

case "$cmd" in
  ftp)       exec "$BIN_DIR/ftp-share" "$@" ;;
  http)      exec "$BIN_DIR/http-share" "$@" ;;
  sftp)      exec "$BIN_DIR/sftp-send" "$@" ;;
  localsend) exec "$BIN_DIR/localsend-start" "$@" ;;
  pairdrop)  exec "$BIN_DIR/pairdrop-open" "$@" ;;
  syncthing) exec "$BIN_DIR/syncthing-start" "$@" ;;
  smb)       exec "$BIN_DIR/smb-info" "$@" ;;
  *)
    cat <<'EOF'
ShareHub (6 + FTP):
  sharehub ftp [slozka] [port]
  sharehub http [slozka] [port]
  sharehub sftp <soubor> <user@host:/cesta>
  sharehub localsend
  sharehub pairdrop [url]
  sharehub syncthing
  sharehub smb
EOF
    ;;
esac
